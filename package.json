{
  "name": "google-ads-api",
  "version": "26.1.0-beta.0",
  "description": "Google Ads API Client Library for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Opteo/google-ads-api.git"
  },
  "main": "./build/index.js",
  "files": [
    "build",
    "!build/scripts"
  ],
  "scripts": {
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "build": "tsc -p tsconfig.build.json",
    "compile": "esbuild --bundle --platform=node ./scripts/index.ts --outfile=./build/scripts/index.cjs && node ./build/scripts/index.cjs",
    "prepare": "rm -rf build && npm run build",
    "node": "tsx",
    "test:package": "npm run build && node tests/package.mjs",
    "postcompile": "prettier --write src/protos/autogen"
  },
  "author": "Opteo",
  "license": "MIT",
  "dependencies": {
    "@isaacs/ttlcache": "^1.4.0",
    "axios": "^1.6.7",
    "circ-json": "^1.0.4",
    "google-ads-node": "26.1.0-beta.0",
    "google-auth-library": "^11.3.3",
    "google-gax": "^6.16.0",
    "long": "^4.0.0",
    "stream-chain": "^4.2.6",
    "stream-json": "^3.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.1",
    "@types/lodash": "^4.14.202",
    "@types/long": "^4.0.0",
    "@types/node": "^22.5.4",
    "@types/pluralize": "^0.0.29",
    "@typescript-eslint/eslint-plugin": "^4.8.2",
    "@typescript-eslint/parser": "^4.8.2",
    "axios-mock-adapter": "^1.22.0",
    "esbuild": "^0.28.2",
    "eslint": "^7.14.0",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "pluralize": "^8.0.0",
    "prettier": "^3.6.2",
    "protobufjs": "^7.2.6",
    "ts-jest": "29.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "google ads",
    "google ads api",
    "google ads node",
    "google ads nodejs",
    "google ads javascript",
    "adwords",
    "adwords api",
    "adwords nodejs",
    "adwords javascript",
    "gads"
  ],
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./enums": {
      "types": "./build/protos/autogen/enums.d.ts",
      "default": "./build/protos/autogen/enums.js"
    },
    "./fields": {
      "types": "./build/protos/autogen/fields.d.ts",
      "default": "./build/protos/autogen/fields.js"
    },
    "./package.json": "./package.json"
  }
}
